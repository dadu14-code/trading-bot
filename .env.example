# ── Broker (Alpaca) ─────────────────────────────────────────────
# Conto DEMO gratuito: https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true            # true = conto demo. NON cambiare finché non hai validato il bot.

# ── Claude (il "trader senior") ────────────────────────────────
# https://console.anthropic.com → API Keys. Se vuoto il bot usa solo le regole quantitative.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── Telegram ────────────────────────────────────────────────────
# 1) Crea il bot con @BotFather → token  2) scrivi al bot, poi apri
#    https://api.telegram.org/bot<TOKEN>/getUpdates per leggere il tuo chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Varie ───────────────────────────────────────────────────────
TZ=Europe/Rome
DRY_RUN=false                # true = calcola tutto ma non invia ordini al broker
DB_PATH=                     # vuoto = ./data/tradebot.db
LOG_LEVEL=INFO
